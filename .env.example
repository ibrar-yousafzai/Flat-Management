# Flat Management Environment Variables
PORT=3000
NODE_ENV=production
SESSION_SECRET=super_secret_flat_management_key_change_in_production

# Optional SMTP Email Configuration (Can also be set in Dashboard Settings)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=yourflat@gmail.com
SMTP_PASS=your_16_char_google_app_password
SMTP_FROM="Flat Management <noreply@flatmanagement.com>"
