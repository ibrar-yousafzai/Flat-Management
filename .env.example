# Supabase Cloud Database Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server Configuration
PORT=3000
NODE_ENV=production
SESSION_SECRET=super_secret_flat_management_key_change_in_production

# Optional SMTP Email Configuration (Can also be set in Settings)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=yourflat@gmail.com
SMTP_PASS=your_16_char_google_app_password
SMTP_FROM="Flat Management <noreply@flatmanagement.com>"
